<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#EEEDEA]">

<%
  const FAQ_STATUS_STYLE = {
    "เผยแพร่แล้ว": "bg-[#E3FBD2] text-[#3A8A12]",
    "รอตรวจสอบ":  "bg-[#FFE9D6] text-[#E07B12]",
  };
%>

<div class="flex min-h-screen">
  <%- include("../partials/sidebar-admin") %>

  <main class="flex-1">
    <%- include("../partials/topbar") %>

    <section class="p-4 flex flex-col gap-4">

      <!-- ค้นหา + ตัวกรอง -->
      <form method="GET" action="/admin/faq" class="flex flex-wrap items-center gap-4">
        <input type="text" name="q" value="<%= filters.q %>" placeholder="ค้นหาคำถาม..."
               class="w-full md:w-[390px] h-11 px-5 rounded-lg border border-gray-400 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]">

        <div class="flex gap-4 md:ml-auto">
          <select name="type" onchange="this.form.submit()"
                  class="h-11 w-[170px] px-4 rounded-lg border border-gray-400 bg-white text-sm">
            <option value="">ทุกประเภท</option>
            <% TYPES.forEach(t => { %>
              <option value="<%= t %>" <%= filters.type === t ? "selected" : "" %>><%= t %></option>
            <% }) %>
          </select>

          <select name="status" onchange="this.form.submit()"
                  class="h-11 w-[170px] px-4 rounded-lg border border-gray-400 bg-white text-sm">
            <option value="">เผยแพร่ทั้งหมด</option>
            <% FAQ_STATUSES.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? "selected" : "" %>><%= s %></option>
            <% }) %>
          </select>
        </div>
      </form>

      <!-- ตาราง -->
      <div class="bg-white p-5 min-h-[640px] overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-gray-500 border-b border-gray-200">
              <th class="text-left py-4 px-4 font-medium border-r border-gray-200 w-[45%]">คำถาม</th>
              <th class="text-left py-4 px-4 font-medium border-r border-gray-200 w-[22%]">อัพเดตล่าสุด</th>
              <th class="py-4 px-4 font-medium border-r border-gray-200 w-[15%]">สถานะ</th>
              <th class="py-4 px-4 font-medium w-[18%]">จัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% if (list.length === 0) { %>
              <tr>
                <td colspan="4" class="py-10 text-center text-gray-400">ไม่พบข้อมูล</td>
              </tr>
            <% } %>

            <% list.forEach(f => { %>
              <tr class="border-b border-gray-200 hover:bg-[#EAF1FB]">
                <td class="py-3 px-4 border-r border-gray-200 font-semibold"><%= f.title %></td>
                <td class="py-3 px-4 border-r border-gray-200 text-xs text-gray-500"><%= formatThaiDate(f.updatedAt) %></td>
                <td class="py-3 px-4 border-r border-gray-200 text-center">
                  <span class="inline-block px-4 py-0.5 rounded-full text-xs whitespace-nowrap <%= FAQ_STATUS_STYLE[f.status] %>">
                    <%= f.status %>
                  </span>
                </td>
                <td class="py-3 px-4">
                  <div class="flex items-center justify-center gap-3">
                    <a href="/admin/faq/<%= f.id %>"
                       class="px-4 py-0.5 rounded-md border border-gray-500 bg-white text-xs font-semibold hover:bg-gray-100">
                      แก้ไข
                    </a>
                    <form method="POST" action="/admin/faq/<%= f.id %>/delete"
                          onsubmit="return confirm('ต้องการลบ &quot;<%= f.title %>&quot; ใช่หรือไม่?')">
                      <button type="submit"
                              class="px-5 py-0.5 rounded-md bg-[#FDDCDC] text-[#E01E1E] text-xs font-semibold hover:bg-[#FBC6C6]">
                        ลบ
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </section>
  </main>
</div>

</body>
</html>