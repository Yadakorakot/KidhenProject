<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#EEEDEA]">

<!-- แก้: ไม่มีช่องเตรียมข้อความและไม่มีร่างรออนุมัติ -->
<div class="flex min-h-screen">
  <%- include("../partials/sidebar-admin") %>

  <main class="flex-1 min-w-0">
    <%- include("../partials/topbar") %>

    <section class="p-4 flex flex-col gap-4">

      <% if (flash) { %>
        <p role="status"
           class="p-4 bg-white rounded-lg
           <%= flash.error
             ? 'text-red-600'
             : 'text-green-700' %>">
          <%= flash.text %>
        </p>
      <% } %>

      <!-- เพิ่ม: สถานะ scheduler และรอบล่าสุด -->
      <div class="bg-white rounded-xl p-5">
        <h2 class="font-bold text-[#1F2A8A] text-xl">
          สรุปปัญหาอัตโนมัติรายสัปดาห์
        </h2>

        <p class="mt-2 text-sm">
          จัดกลุ่มเพื่อแสดงภาพรวม
          ไม่รวมงานหรือปิดคำร้องอัตโนมัติ
        </p>

        <p class="mt-2 text-sm">
          รอบถัดไป:
          <%= enabled && nextRunAt
            ? formatThaiDate(nextRunAt)
            : "ปิดการตั้งเวลา" %>
          (เวลาไทย)
        </p>

        <p class="mt-2 text-sm">
          สถานะ:
          <%= running
            ? "กำลังประมวลผล — กดรีเฟรชเพื่อตรวจผล"
            : "พร้อมทำงาน" %>
        </p>

        <% if (lastRun) { %>
          <p class="mt-2 text-sm">
            รอบล่าสุด:
            <%= formatThaiDate(lastRun.finishedAt) %>
            · <%= lastRun.success
              ? "สำเร็จ" : "ไม่สำเร็จ" %>
            · ประมวลผล
            <%= lastRun.processed %> คำร้อง
            · เก็บภายในเพิ่ม
            <%= lastRun.heldCount %> คำร้อง
          </p>

          <% if (!lastRun.success) { %>
            <p class="mt-2 text-red-600">
              <%= lastRun.error %>
            </p>
          <% } %>
        <% } %>

        <form method="POST"
              action="/admin/faq/run"
              class="mt-4">
          <input type="hidden"
                 name="_csrf"
                 value="<%= aiCsrf %>">

          <button
            <%= running ? "disabled" : "" %>
            class="bg-[#F6A85A] rounded-full
                   px-6 py-2 font-semibold
                   disabled:opacity-50">
            ประมวลผลตอนนี้
          </button>
        </form>

        <p class="mt-2 text-xs text-gray-500">
          ปุ่มนี้เรียก Gemini จริง เฉพาะข้อมูลใหม่/เปลี่ยน
          และไม่เปลี่ยนวันเวลารอบประจำ
        </p>
      </div>

      <!-- ของเดิม: ค้นหาและกรอง -->
      <form method="GET"
            action="/admin/faq"
            class="flex flex-wrap gap-3">

        <input name="q"
               value="<%= filters.q %>"
               placeholder="ค้นหาหัวข้อ"
               class="bg-white border rounded-lg p-3">

        <select name="type"
                class="bg-white border rounded-lg p-3">
          <option value="">ทุกประเภท</option>

          <% TYPES.forEach(t => { %>
            <option
              <%= filters.type === t
                ? "selected" : "" %>
            ><%= t %></option>
          <% }) %>
        </select>

        <select name="status"
                class="bg-white border rounded-lg p-3">

          <option value="">
            ทุกสถานะการเผยแพร่
          </option>

          <option value="published"
            <%= filters.status === "published"
              ? "selected" : "" %>>
            เผยแพร่แล้ว
          </option>

          <option value="hidden"
            <%= filters.status === "hidden"
              ? "selected" : "" %>>
            ซ่อนอยู่
          </option>
        </select>

        <button class="bg-[#1F2A8A] text-white
                       rounded-lg px-5">
          ค้นหา
        </button>
      </form>

      <!-- แก้: แสดงจำนวนงานแต่ละสถานะแยกกัน -->
      <div class="bg-white rounded-xl p-5 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b text-left text-gray-500">
              <th class="p-3">หัวข้อ</th>
              <th class="p-3">สถานะคำร้อง</th>
              <th class="p-3">การเผยแพร่</th>
              <th class="p-3">จัดการ</th>
            </tr>
          </thead>

          <tbody>
            <% if (!list.length) { %>
              <tr>
                <td colspan="4"
                    class="p-10 text-center text-gray-500">
                  ยังไม่มีสรุป
                  กดประมวลผลตอนนี้เพื่อทดสอบ
                </td>
              </tr>
            <% } %>

            <% list.forEach(t => { %>
              <tr class="border-b">
                <td class="p-3">
                  <p class="font-semibold">
                    <%= t.title %>
                  </p>

                  <p class="text-xs text-gray-500 mt-2">
                    <%= t.type %>
                    · <%= t.location %>
                    · <%= t.people %> คน
                    / <%= t.count %> คำร้อง
                  </p>
                </td>

                <td class="p-3">
                  รอ <%= t.counts["รอดำเนินการ"] %>
                  · กำลังทำ
                  <%= t.counts["กำลังดำเนินการ"] %>
                  · เสร็จ
                  <%= t.counts["เสร็จสิ้น"] %>
                </td>

                <td class="p-3">
                  <%= t.published
                    ? "เผยแพร่แล้ว" : "ซ่อนอยู่" %>
                </td>

                <td class="p-3">
                  <a class="text-[#1F2A8A] underline"
                     href="/admin/faq/topics/<%= t.id %>">
                    ดูและแก้ไข
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- เพิ่ม: คำร้องภายในยังไม่หายและดำเนินการได้ตามปกติ -->
      <details class="bg-white p-5 rounded-xl">
        <summary class="cursor-pointer font-semibold">
          คำร้องที่เก็บภายใน
          <%= held.length %> รายการ
        </summary>

        <p class="text-sm text-gray-500 mt-3">
          พบข้อมูลละเอียดอ่อน/เรื่องบุคคล
          หรือยังไม่มีอาการที่ระบบรองรับ
          คำร้องยังดำเนินการตามปกติ ไม่ได้ถูกปฏิเสธ
        </p>

        <% held.forEach(r => { %>
          <p class="mt-3">
            <a class="underline"
               href="/admin/requests/<%= r.id %>">
              <%= r.code %> — <%= r.title %>
            </a>
          </p>
        <% }) %>
      </details>

    </section>
  </main>
</div>

</body>
</html>