<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | รายละเอียดปัญหาที่พบบ่อย</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#EEEDEA]">
<div class="flex min-h-screen">
  <%- include("../partials/sidebar-admin") %>

  <main class="flex-1">
    <%- include("../partials/topbar") %>

    <section class="p-4">
      <form method="POST" action="/admin/faq/<%= item.id %>/approve"
            class="bg-white p-6 min-h-[640px] flex flex-col">

        <!-- ปุ่มย้อนกลับ -->
        <a href="/admin/faq" title="ย้อนกลับ"
           class="w-9 h-9 rounded-full bg-[#F6A85A] flex items-center justify-center hover:opacity-80">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </a>

        <h2 class="text-xl font-bold text-[#1F2A8A] mt-2 pb-3 border-b-4 border-[#E2E1DD]">
          รายละเอียดปัญหาที่พบบ่อย
        </h2>

        <!-- กล่องข้อมูล -->
        <div class="mt-5 bg-[#FDF1EA] rounded-xl p-6 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-0">
          <div class="md:pr-6 md:border-r-2 border-[#F6A85A]">
            <p class="text-sm font-semibold text-[#F6A85A] mb-3">หัวข้อ</p>
            <p class="text-sm"><%= item.title %></p>
          </div>
          <div class="md:px-6 md:border-r-2 border-[#F6A85A]">
            <p class="text-sm font-semibold text-[#F6A85A] mb-3">คำร้องที่พบ</p>
            <p class="text-sm">จำนวน <%= item.count %> ครั้ง</p>
          </div>
          <div class="md:pl-6">
            <p class="text-sm font-semibold text-[#F6A85A] mb-3">ประเภทคำร้อง</p>
            <p class="text-sm"><%= item.type %></p>
          </div>
        </div>

        <!-- คำอธิบายก่อนเผยแพร่ -->
        <label for="answer" class="mt-8 font-bold text-[#1F2A8A]">คำอธิบายก่อนเผยแพร่</label>
        <textarea id="answer" name="answer" rows="4" required
                  placeholder="เช่น อาคารสถานที่ส่งเรื่องให้ทางคณะซ่อมแซมเรียบร้อยแล้ว"
                  class="mt-3 w-full rounded-xl border-4 border-[#1E9BFF] p-4 text-sm focus:outline-none focus:border-[#1F2A8A]"><%= item.answer %></textarea>

        <% if (error) { %>
          <p class="text-sm text-red-600 mt-2"><%= error %></p>
        <% } %>

        <!-- ปุ่ม -->
        <div class="mt-auto pt-10 flex justify-end gap-4">
          <a href="/admin/faq"
             class="w-[130px] h-10 rounded-full border border-black bg-[#D9D9D9] font-semibold flex items-center justify-center hover:bg-[#C9C9C9]">
            ยกเลิก
          </a>
          <button type="submit"
                  class="w-[130px] h-10 rounded-full border border-black bg-[#F6A85A] font-semibold hover:bg-[#F39A3E]">
            อนุมัติ
          </button>
        </div>

      </form>
    </section>
  </main>
</div>
</body>
</html>