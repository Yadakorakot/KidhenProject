<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#EEEDEA]">
<div class="flex min-h-screen">
  <%- include("../partials/sidebar-user") %>

  <main class="flex-1">
    <%- include("../partials/topbar") %>

    <section class="p-6 flex flex-col gap-4">

      <!-- ค้นหา + ตัวกรอง -->
      <form method="GET" action="/user/requests" class="flex flex-wrap items-center gap-4">
        <input type="text" name="q" value="<%= filters.q %>" placeholder="ค้นหาคำร้อง..."
               class="w-full md:w-[420px] h-11 px-5 rounded-lg border border-gray-400 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]">

        <div class="flex gap-4 md:ml-auto">
          <select name="type" onchange="this.form.submit()"
                  class="h-11 w-[180px] px-4 rounded-lg border border-gray-400 bg-white text-sm">
            <option value="">ทุกประเภท</option>
            <% TYPES.forEach(t => { %>
              <option value="<%= t %>" <%= filters.type === t ? "selected" : "" %>><%= t %></option>
            <% }) %>
          </select>

          <select name="status" onchange="this.form.submit()"
                  class="h-11 w-[180px] px-4 rounded-lg border border-gray-400 bg-white text-sm">
            <option value="">ทุกสถานะ</option>
            <% STATUSES.forEach(s => { %>
              <option value="<%= s %>" <%= filters.status === s ? "selected" : "" %>><%= s %></option>
            <% }) %>
          </select>
        </div>
      </form>

      <!-- ตารางคำร้อง -->
      <div class="bg-white p-6 min-h-[560px] overflow-x-auto">
        <h2 class="text-lg font-bold mb-4">คำร้องทั้งหมด (<%= list.length %> รายการ)</h2>

        <table class="w-full text-sm">
          <thead>
            <tr class="text-gray-500 border-b-2 border-gray-700">
              <th class="text-left py-3 px-4 font-medium">หมายเลขคำร้อง</th>
              <th class="text-left py-3 px-4 font-medium">หัวข้อ</th>
              <th class="py-3 px-4 font-medium">ประเภท</th>
              <th class="py-3 px-4 font-medium">วันที่แจ้ง</th>
              <th class="py-3 px-4 font-medium">สถานะ</th>
              <th class="py-3 px-4 font-medium"></th>
            </tr>
          </thead>

          <tbody>
            <% if (list.length === 0) { %>
              <tr>
                <td colspan="6" class="py-10 text-center text-gray-400">ไม่พบคำร้อง</td>
              </tr>
            <% } %>

            <% list.forEach(r => { %>
              <tr class="border-b border-gray-200 hover:bg-[#EAF1FB]">
                <td class="py-3 px-4 font-semibold"><%= r.code %></td>
                <td class="py-3 px-4"><%= r.title %></td>
                <td class="py-3 px-4 text-center"><%= r.type %></td>
                <td class="py-3 px-4 text-center"><%= r.date %></td>
                <td class="py-3 px-4 text-center">
                  <%- include("../partials/status-badge", { status: r.status }) %>
                </td>
                <td class="py-3 px-4 text-center">
                  <a href="/user/requests/<%= r.id %>"
                     class="inline-block px-3 py-0.5 rounded-md border border-gray-700 bg-[#D9D9D9] text-xs whitespace-nowrap hover:bg-[#C9C9C9]">
                    รายละเอียด
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </section>
  </main>
</div>
</body>
</html>