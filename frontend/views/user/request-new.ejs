<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KIDHEN | <%= title %></title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-[#EEEDEA]">
<div class="flex min-h-screen">
  <%- include("../partials/sidebar-user") %>

  <main class="flex-1">
    <%- include("../partials/topbar") %>

    <section class="p-4">
      <div class="bg-white p-6 min-h-[640px]">

        <!-- ปุ่มย้อนกลับ -->
        <a href="/user/home" title="ย้อนกลับ"
           class="w-9 h-9 rounded-full bg-[#F6A85A] flex items-center justify-center hover:opacity-80">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </a>

        <form id="requestForm" method="POST" action="/user/requests/new" enctype="multipart/form-data"
              class="max-w-[600px] mx-auto flex flex-col gap-4 mt-2">

          <% if (error) { %>
            <p class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-4 py-2"><%= error %></p>
          <% } %>

          <!-- ประเภทคำร้อง -->
          <div>
            <label for="type" class="block font-bold text-[#1F2A8A] mb-1">ประเภทคำร้อง</label>
            <select id="type" name="type" required
                    class="w-full h-10 px-3 rounded-md border border-gray-500 bg-white text-sm invalid:text-gray-400">
              <option value="" disabled <%= values.type ? "" : "selected" %>>ประเภทคำร้อง</option>
              <% TYPES.forEach(t => { %>
                <option value="<%= t %>" class="text-black" <%= values.type === t ? "selected" : "" %>><%= t %></option>
              <% }) %>
            </select>
          </div>

          <!-- หัวข้อ -->
          <div>
            <label for="title" class="block font-bold text-[#1F2A8A] mb-1">หัวข้อ</label>
            <input id="title" name="title" type="text" required value="<%= values.title || '' %>"
                   placeholder="เช่น เครื่องปรับอากาศห้อง 306 เสีย"
                   class="w-full h-10 px-3 rounded-md border border-gray-500 text-sm placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]">
          </div>

          <!-- สถานที่ -->
          <div>
            <label for="location" class="block font-bold text-[#1F2A8A] mb-1">สถานที่</label>
            <input id="location" name="location" type="text" required value="<%= values.location || '' %>"
                   placeholder="เช่น ตึกคณะไอที ห้อง 306 (ถ้าไม่มีให้ใส่ -)"
                   class="w-full h-10 px-3 rounded-md border border-gray-500 text-sm placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]">
          </div>

          <!-- รายละเอียด -->
          <div>
            <label for="detail" class="block font-bold text-[#1F2A8A] mb-1">รายละเอียด</label>
            <textarea id="detail" name="detail" rows="5" required
                      placeholder="อธิบายปัญหาที่พบ (ถ้าไม่มีให้ใส่ -)"
                      class="w-full px-3 py-2 rounded-md border border-gray-500 text-sm placeholder:text-gray-300 focus:outline-none focus:ring-2 focus:ring-[#1F2A8A]"><%= values.detail || '' %></textarea>
          </div>

          <!-- แนบรูป -->
          <div>
            <label for="images" class="block font-bold text-[#1F2A8A] mb-1">
              รูปภาพแนบ <span class="font-normal text-xs text-gray-400">(ไม่บังคับ สูงสุด 3 รูป รูปละไม่เกิน 5MB)</span>
            </label>
            <input id="images" name="images" type="file" accept="image/*" multiple
                  class="text-xs file:mr-3 file:px-3 file:py-1 file:rounded file:border file:border-gray-500 file:bg-gray-100 file:text-xs hover:file:bg-gray-200">

            <div id="previews" class="flex gap-4 mt-3 h-[100px]"></div>
          </div>

          <!-- ปุ่ม -->
          <div class="flex justify-end gap-4 mt-4">
            <button type="reset"
                    class="w-[130px] h-10 rounded-full border border-black bg-[#D9D9D9] font-semibold hover:bg-[#C9C9C9]">
              ล้างข้อมูล
            </button>
            <button type="submit"
                    class="w-[130px] h-10 rounded-full border border-black bg-[#F6A85A] font-semibold hover:bg-[#F39A3E]">
              ส่งคำร้อง
            </button>
          </div>
        </form>

      </div>
    </section>
  </main>
</div>

<script>
  const input = document.getElementById("images");
  const previews = document.getElementById("previews");
  const MAX_FILES = 3;
  const MAX_SIZE = 5 * 1024 * 1024; // 5MB

  function clearPreviews() {
    previews.innerHTML = "";
  }

  input.addEventListener("change", () => {
    clearPreviews();
    const files = [...input.files];

    if (files.length > MAX_FILES) {
      alert("แนบรูปได้สูงสุด 3 รูป");
      input.value = "";
      return;
    }

    if (files.some((f) => f.size > MAX_SIZE)) {
      alert("มีรูปที่ขนาดเกิน 5MB กรุณาเลือกใหม่");
      input.value = "";
      return;
    }

    // สร้างรูปตัวอย่างตามจำนวนที่เลือก
    files.forEach((file) => {
      const img = document.createElement("img");
      img.src = URL.createObjectURL(file);
      img.alt = file.name;
      img.className = "w-[100px] h-[100px] rounded-lg object-cover border border-gray-200";
      previews.appendChild(img);
    });
  });

  // กด ล้างข้อมูล → รูปตัวอย่างหายไปด้วย
  document.getElementById("requestForm").addEventListener("reset", clearPreviews);
</script>
</body>
</html>